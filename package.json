    "dotenv": "^16.6.1",
    "js2me-biome-config": "^1.0.8",
    "lefthook": "^1.13.6",
    "lodash": "^4.17.23",
    "packalink": "^0.0.17",
    "postcss": "^8.5.6",
    "postcss-import": "^16.1.1",
    "postcss-normalize": "^13.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "socks-proxy-agent": "^8.0.5",
    "tailwind-children": "^0.5.0",
    "tailwindcss": "^4.1.18",
    "tailwindcss-animate": "^1.0.7",
    "terser": "^5.46.0",
