{
  "name": "frontend-quiz",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "^24",
    "yarn": "please-use-pnpm",
    "npm": "please-use-pnpm",
    "pnpm": ">=9.15.5"
  },
  "type": "module",
  "scripts": {
    "postinstall": "pnpm dev:install-hooks && pnpm lint:fix",
    "dev": "cross-env NODE_ENV=development PROXY=true vite --host 0.0.0.0",
    "build": "cross-env NODE_ENV=production vite build",
    "ts:check": "tsc --noEmit",
    "build:preview": "cross-env NODE_ENV=production PROXY=true MODE=preview vite build",
    "preview": "cross-env NODE_ENV=production PROXY=true MODE=preview vite preview --host 0.0.0.0",
    "lint": "biome check",
    "lint:fix": "pnpm exec biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "dev:link-packages": "pnpm packalink",
    "dev:install-hooks": "if [ -z \"$CI\" ]; then lefthook install; fi"
  },
  "dependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-proposal-explicit-resource-management": "^7.27.4",
    "@hookform/resolvers": "^5.2.2",
    "@mantine/core": "^8.3.14",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "linked-abort-controller": "^1.1.1",
    "lodash-es": "^4.17.23",
    "lucide-react": "^0.509.0",
    "mobx": "^6.15.0",
    "mobx-react-hook-form": "^6.2.1",
    "mobx-react-lite": "^4.1.1",
    "mobx-route": "^0.23.5",
    "mobx-swiss-knife": "^1.14.1",
    "mobx-view-model": "^8.10.1",
    "plural-ru": "^2.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "react-shared-utils": "^3.2.0",
    "react-simple-loadable": "^3.0.0",
    "tailwind-merge": "^3.4.0",
    "yummies": "^7.3.1",
    "zod": "^4.3.6",
    "zod-i18n-better-ru": "^1.1.1"
